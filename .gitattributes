# These source formats use LF in the repository and in working trees.
# Git converts CRLF to LF when staging matching text files; inspect the diff.
# Unmatched paths retain Git's normal text/binary detection.
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.ps1 text eol=lf
requirements.basic-memory.lock text eol=lf
LICENSE text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
